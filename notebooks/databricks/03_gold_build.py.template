# COMMAND ----------
# MAGIC %pip install --no-deps git+https://github.com/Abhyudaya01/retail-demand-inventory.git
# MAGIC %pip install boto3 s3fs holidays "pydantic>=2" pydantic-settings typer structlog python-dotenv

# COMMAND ----------
dbutils.library.restartPython()

# COMMAND ----------
from retail_demand.gold.build import default_sql_dir

SILVER_ROOT = "/Volumes/workspace/retail_demand/silver"
GOLD_ROOT = "/Volumes/workspace/retail_demand/gold"
MODE = "overwrite"
SQL_DIR = default_sql_dir()

# COMMAND ----------
from retail_demand.gold.build import GoldBuilder

results = GoldBuilder(spark, SILVER_ROOT, GOLD_ROOT, SQL_DIR).build_all(mode=MODE)
print(f"{'Table':<24} {'Rows':>12} {'Seconds':>10}")
for table, stats in results.items():
    print(f"{table:<24} {stats['rows_written']:>12,} {stats['duration_seconds']:>10.2f}")

# COMMAND ----------
from retail_demand.gold.leakage_audit import audit_features_master

audit = audit_features_master(spark, GOLD_ROOT)
display(
    spark.createDataFrame(
        [
            {
                "feature": feature,
                "passes": result["passes"],
                "sample_size_checked": result["sample_size_checked"],
                "mismatches": result["mismatches"],
            }
            for feature, result in audit.items()
        ]
    )
)
failed = [feature for feature, result in audit.items() if not result["passes"]]
if failed:
    raise RuntimeError(f"Gold leakage audit failed: {', '.join(failed)}")

# COMMAND ----------
features_master = spark.read.format("delta").load(f"{GOLD_ROOT}/features_master")
features_master.printSchema()
display(features_master.limit(10))

