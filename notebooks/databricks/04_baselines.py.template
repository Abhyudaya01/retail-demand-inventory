# COMMAND ----------
# MAGIC %pip install --no-deps --force-reinstall git+https://github.com/Abhyudaya01/retail-demand-inventory.git
# MAGIC %pip install boto3 s3fs holidays "pydantic>=2" pydantic-settings typer structlog python-dotenv

# COMMAND ----------
dbutils.library.restartPython()

# COMMAND ----------
GOLD_ROOT = "/Volumes/workspace/retail_demand/gold"
EXPERIMENT_PATH = "/Users/alohani@umd.edu/retail-demand-forecasting"
CV_FOLDS = 3
HORIZON = 28
MIN_TRAIN = 365

# COMMAND ----------
from retail_demand.mlflow_setup import configure_mlflow

experiment_id = configure_mlflow(EXPERIMENT_PATH)
print(f"MLflow experiment_id={experiment_id}")

# COMMAND ----------
features_master = spark.read.format("delta").load(f"{GOLD_ROOT}/features_master")
date_bounds = features_master.agg({"date": "min"}).first()[0], features_master.agg({"date": "max"}).first()[0]
print(f"features_master rows={features_master.count():,}")
print(f"date range ns={date_bounds[0]} to {date_bounds[1]}")

# COMMAND ----------
from retail_demand.experiments.run_baselines import run_baselines

comparison = run_baselines(
    spark,
    GOLD_ROOT,
    EXPERIMENT_PATH,
    cv_folds=CV_FOLDS,
    horizon_days=HORIZON,
    min_train_days=MIN_TRAIN,
)

# COMMAND ----------
display(spark.createDataFrame(comparison))

# COMMAND ----------
print(f"Open MLflow experiment: {EXPERIMENT_PATH}")

