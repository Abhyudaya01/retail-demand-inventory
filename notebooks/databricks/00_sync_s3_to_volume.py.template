# ── Cell 2: AWS credentials ── DELETE THIS CELL BEFORE SAVING ─────────────────
import os

# TODO: replace the placeholder values with your real credentials before running.
# TODO: DELETE THIS CELL (or replace with dbutils.secrets calls) before saving.
os.environ["AWS_ACCESS_KEY_ID"] = "REPLACE_WITH_YOUR_ACCESS_KEY_ID"        # ← PLACEHOLDER
os.environ["AWS_SECRET_ACCESS_KEY"] = "REPLACE_WITH_YOUR_SECRET_ACCESS_KEY"  # ← PLACEHOLDER
os.environ["AWS_DEFAULT_REGION"] = "us-east-1"

AWS_ACCESS_KEY = os.environ["AWS_ACCESS_KEY_ID"]
AWS_SECRET_KEY = os.environ["AWS_SECRET_ACCESS_KEY"]
AWS_REGION = os.environ.get("AWS_DEFAULT_REGION", "us-east-1")

# ── Cell 3: configuration ──────────────────────────────────────────────────────
# Adjust S3_BUCKET and VOLUME_ROOT to match your environment.
S3_BUCKET = "abhi-retail-demand-2026"       # your S3 bucket
S3_RAW_PREFIX = "raw"                        # prefix written by the generator
VOLUME_ROOT = "/Volumes/workspace/retail_demand/raw"  # Databricks Volume path

TABLES = ["stores", "products", "calendar", "prices", "sales"]

# ── Cell 4: sync ──────────────────────────────────────────────────────────────
from retail_demand.io.databricks_sync import sync_s3_to_volume  # noqa: E402

results = {}
for table in TABLES:
    s3_uri = f"s3://{S3_BUCKET}/{S3_RAW_PREFIX}/{table}/"
    dest = f"{VOLUME_ROOT}/{table}"
    print(f"Syncing {s3_uri} → {dest} ...")
    stats = sync_s3_to_volume(
        s3_uri=s3_uri,
        volume_path=dest,
        aws_access_key=AWS_ACCESS_KEY,
        aws_secret_key=AWS_SECRET_KEY,
        aws_region=AWS_REGION,
    )
    results[table] = stats
    print(
        f"  ✓ {table}: synced={stats['files_synced']}  skipped={stats['files_skipped']}"
        f"  bytes={stats['bytes_transferred']:,}  time={stats['duration_seconds']}s"
    )

# ── Cell 5: summary table ─────────────────────────────────────────────────────
print("\n{'Table':<12} {'Synced':>8} {'Skipped':>8} {'MB':>10} {'Secs':>8}")
print("-" * 52)
for table, s in results.items():
    mb = s["bytes_transferred"] / (1024 * 1024)
    print(
        f"{table:<12} {s['files_synced']:>8} {s['files_skipped']:>8}"
        f" {mb:>10.2f} {s['duration_seconds']:>8.1f}"
    )

total_synced = sum(s["files_synced"] for s in results.values())
total_bytes = sum(s["bytes_transferred"] for s in results.values())
print(f"\nTotal files synced: {total_synced}, total bytes: {total_bytes:,}")

