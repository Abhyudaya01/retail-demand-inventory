# PURPOSE: copies parquet files from S3 raw/ into a Databricks Volume so Spark
# can read them without needing fs.s3a.access.key (which Free Edition blocks).
#
# INSTRUCTIONS:
# 1. Upload this file to Databricks as a Python notebook.
# 2. Fill in the AWS placeholders in Cell 2.
# 3. Run all cells.
# 4. *** DELETE CELL 2 BEFORE SAVING. ***

# ── Cell 1: install package from GitHub ────────────────────────────────────────
%pip install git+https://github.com/Abhyudaya01/retail-demand-inventory.git
dbutils.library.restartPython()

# ── Cell 2: AWS credentials ── DELETE THIS CELL BEFORE SAVING ─────────────────
import os
os.environ["AWS_ACCESS_KEY_ID"] = "REPLACE_WITH_YOUR_ACCESS_KEY_ID"
os.environ["AWS_SECRET_ACCESS_KEY"] = "REPLACE_WITH_YOUR_SECRET_ACCESS_KEY"
os.environ["AWS_DEFAULT_REGION"] = "us-east-1"

# ── Cell 3: configuration ──────────────────────────────────────────────────────
S3_BUCKET = "abhi-retail-demand-2026"
S3_RAW_PREFIX = "raw"
VOLUME_ROOT = "/Volumes/workspace/retail_demand/raw"
TABLES = ["stores", "products", "calendar", "prices", "sales"]

# ── Cell 4: sync ──────────────────────────────────────────────────────────────
# Reads AWS creds from os.environ (set in Cell 2). If Cell 2 was deleted,
# this cell fails loudly with KeyError — the desired safety behavior.
import os
from retail_demand.io.databricks_sync import sync_s3_to_volume

AWS_ACCESS_KEY = os.environ["AWS_ACCESS_KEY_ID"]
AWS_SECRET_KEY = os.environ["AWS_SECRET_ACCESS_KEY"]
AWS_REGION = os.environ.get("AWS_DEFAULT_REGION", "us-east-1")

results = {}
for table in TABLES:
    s3_uri = f"s3://{S3_BUCKET}/{S3_RAW_PREFIX}/{table}/"
    dest = f"{VOLUME_ROOT}/{table}"
    print(f"Syncing {s3_uri} -> {dest} ...")
    stats = sync_s3_to_volume(
        s3_uri=s3_uri,
        volume_path=dest,
        aws_access_key=AWS_ACCESS_KEY,
        aws_secret_key=AWS_SECRET_KEY,
        aws_region=AWS_REGION,
    )
    results[table] = stats
    print(
        f"  OK {table}: synced={stats['files_synced']} skipped={stats['files_skipped']}"
        f" bytes={stats['bytes_transferred']:,}"
    )

# ── Cell 5: summary ────────────────────────────────────────────────────────────
print(f"\n{'Table':<12} {'Synced':>8} {'Skipped':>8} {'MB':>10}")
print("-" * 44)
for table, s in results.items():
    mb = s["bytes_transferred"] / (1024 * 1024)
    print(f"{table:<12} {s['files_synced']:>8} {s['files_skipped']:>8} {mb:>10.2f}")

# ── Cell 6: verify Volume contents ─────────────────────────────────────────────
display(dbutils.fs.ls(VOLUME_ROOT))
