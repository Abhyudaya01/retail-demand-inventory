# AWS credentials — AWS_PROFILE takes precedence over inline AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY.
# For local development, set AWS_PROFILE and configure the profile via `aws configure --profile <name>`.
# For CI or Databricks notebook use, set AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY directly instead.
AWS_PROFILE=retail-demand
AWS_REGION=us-east-1

# S3 bucket and medallion prefixes
S3_BUCKET=
S3_RAW_PREFIX=raw
S3_BRONZE_PREFIX=bronze
S3_SILVER_PREFIX=silver
S3_GOLD_PREFIX=gold

# Databricks Volume root — the sync utility copies raw S3 objects here.
# Adjust catalog/schema/volume names to match your workspace.
DATABRICKS_VOLUME_ROOT=/Volumes/workspace/retail_demand/raw

# Generator defaults
RANDOM_SEED=42
